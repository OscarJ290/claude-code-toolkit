{
  "name": "freelance-toolkit",
  "version": "0.1.0",
  "description": "Claude Code plugin with skills for repository handoff, project scoping, CFDI validation and Gmail triage, plus a CFDI tools MCP server.",
  "author": {
    "name": "Oscar J. Villa Garcia",
    "url": "https://github.com/OscarJ290"
  },
  "license": "MIT",
  "repository": "https://github.com/OscarJ290/claude-code-toolkit",
  "mcpServers": {
    "cfdi-tools": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}/servers/cfdi-tools",
        "python",
        "server.py"
      ]
    }
  }
}
